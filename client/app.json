{
  "expo": {
    "name": "Loona",
    "slug": "loona",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "loona",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loona.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Loona uses your location to autofill event venue for posts.",
        "NSPhotoLibraryUsageDescription": "Loona needs photo library access to attach images to your posts.",
        "NSCameraUsageDescription": "Loona needs camera access to take photos for your posts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "package": "com.loona.app",
      "versionCode": 30,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C94030",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loona needs photo library access to attach images to your posts.",
          "cameraPermission": "Loona needs camera access to take photos for your posts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Loona uses your location to autofill event venue for posts."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45dd7a2a-df99-4eb9-98ca-4ab0b68b3c1c"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/45dd7a2a-df99-4eb9-98ca-4ab0b68b3c1c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "owner": "loonaofficial"
  }
}
