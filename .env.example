# ─── Server Environment Variables ───────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/loona
JWT_SECRET=your_super_secret_jwt_key_rotate_this
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
LOG_LEVEL=info

# Sentry (Optional for local dev)
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Monetization)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Redis (Required for Phase 4: Rate Limiting & Scaling)
REDIS_URL=redis://localhost:6379

# Admin
OWNER_USER_ID=your_admin_user_id
ALLOWED_ORIGINS=https://loona.app,https://admin.loona.app,exp://

# ─── Client Environment Variables ───────────────────────────────────────────
# For Expo / React Native
EXPO_PUBLIC_API_URL=http://<your_local_ip>:5000/api
