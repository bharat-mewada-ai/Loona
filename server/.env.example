# ─── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/loona?retryWrites=true&w=majority

# ─── Redis (for Caching & Rate Limiting) ──────────────────────────────────
REDIS_URL=redis://default:<password>@<host>:<port>

# ─── Authentication ────────────────────────────────────────────────────────
# Use a strong, random 32+ character string
JWT_SECRET=your_super_secret_jwt_key_here_rotate_this_for_prod
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Cloudinary (Image Hosting) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (Monetization) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Security & Monitoring ─────────────────────────────────────────────────
# Whitelist of allowed origins for CORS
ALLOWED_ORIGINS=https://loona.app,https://admin.loona.app,exp://
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ─── Admin ─────────────────────────────────────────────────────────────────
OWNER_USER_ID=your_admin_user_id
