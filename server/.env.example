# Copy this file to .env and fill in real values. NEVER commit .env itself.

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/loona

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-hex-string>

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Redis (optional — disables caching/rate-limit-redis if omitted)
REDIS_URL=redis://default:<password>@<host>:<port>

# Sentry (optional — error tracking)
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Comma-separated list of origins allowed to call the API from a browser.
# Native mobile apps (Expo/React Native) don't need to be listed here — they have no Origin header.
# Dev defaults (localhost:8081, :19000, :19006, :3000) are always included automatically.
# Example for production: ALLOWED_ORIGINS=https://loona.app,https://admin.loona.app
ALLOWED_ORIGINS=
