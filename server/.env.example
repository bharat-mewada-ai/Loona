# ─── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/loona?retryWrites=true&w=majority

# ─── Redis (for Caching & Rate Limiting) ──────────────────────────────────
REDIS_URL=redis://default:<password>@<host>:<port>

# ─── Authentication ────────────────────────────────────────────────────────
# Use a strong, random 32+ character string
JWT_SECRET=your_super_secret_jwt_key_here_rotate_this_for_prod

# ─── Cloudinary (Image Hosting) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (Monetization) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Push Notifications ────────────────────────────────────────────────────
# No secret needed for Expo SDK usually, but keep this for future FCM/APNS keys
EXPO_PROJECT_ID=your_expo_project_id

# ─── Security ──────────────────────────────────────────────────────────────
# Whitelist of allowed origins for CORS
CORS_WHITELIST=https://loona.app,https://admin.loona.app,exp://
